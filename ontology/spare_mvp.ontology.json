{
  "name": "Spare Planning and Mission Reliability Prototype",
  "description": "Lightweight ontology extracted from the design document for spare planning and mission reliability ABM prototyping.",
  "source": "docs/3概要设计方案.md",
  "metadata": {
    "developmentMode": "Simulation-Contract-First Development",
    "format": "Ontology-Playground-compatible JSON",
    "namespace": "https://spare-mvp.local/ontology",
    "version": "0.2.0",
    "contractRole": "Simulation/Ontology Contract"
  },
  "entityTypes": [
    {
      "id": "mission_profile",
      "name": "任务剖面",
      "description": "Long-period, clustered, or single-equipment mission profile.",
      "icon": "route",
      "color": "#0078D4",
      "properties": [
        {"name": "profileId", "type": "string", "isIdentifier": true},
        {"name": "profileType", "type": "enum", "values": ["长周期任务", "多机集群任务", "单机任务"]},
        {"name": "repeatCycleHours", "type": "decimal"},
        {"name": "endCondition", "type": "string"}
      ]
    },
    {
      "id": "basic_mission",
      "name": "基本任务",
      "description": "Mission definition with timing, priority, success point, and minimum equipment requirement.",
      "icon": "target",
      "color": "#107C10",
      "properties": [
        {"name": "missionId", "type": "string", "isIdentifier": true},
        {"name": "successPoint", "type": "string"},
        {"name": "startHour", "type": "decimal"},
        {"name": "returnRatio", "type": "decimal"},
        {"name": "priority", "type": "integer"},
        {"name": "minRequiredSorties", "type": "integer"}
      ]
    },
    {
      "id": "mission_phase",
      "name": "任务阶段",
      "description": "Finite-state mission phase with transition condition and duration limit.",
      "icon": "timer",
      "color": "#00A9E0",
      "properties": [
        {"name": "phaseId", "type": "string", "isIdentifier": true},
        {"name": "state", "type": "enum", "values": ["待命", "准备", "出动", "任务执行", "回收", "飞行后检查"]},
        {"name": "transitionCondition", "type": "string"},
        {"name": "limitHours", "type": "decimal"}
      ]
    },
    {
      "id": "combat_unit",
      "name": "基本作战单元",
      "description": "Deployed unit containing mission equipment.",
      "icon": "group",
      "color": "#5C2D91",
      "properties": [
        {"name": "unitId", "type": "string", "isIdentifier": true},
        {"name": "equipmentType", "type": "string"},
        {"name": "quantity", "type": "integer"},
        {"name": "deploymentLocation", "type": "string"}
      ]
    },
    {
      "id": "equipment",
      "name": "装备",
      "description": "Aircraft or equipment that can prepare, sortie, fail, repair, and return to ready state.",
      "icon": "plane",
      "color": "#D83B01",
      "properties": [
        {"name": "equipmentId", "type": "string", "isIdentifier": true},
        {"name": "model", "type": "string"},
        {"name": "state", "type": "enum", "values": ["idle", "preparing", "sortie", "failed", "repairing", "ready"]},
        {"name": "failureRate", "type": "decimal"}
      ]
    },
    {
      "id": "component",
      "name": "产品/组件",
      "description": "Component installed on equipment with failure model, spare type, and reliability block role.",
      "icon": "cpu",
      "color": "#8764B8",
      "properties": [
        {"name": "componentId", "type": "string", "isIdentifier": true},
        {"name": "name", "type": "string"},
        {"name": "spareType", "type": "string"},
        {"name": "failureModel", "type": "enum", "values": ["随机", "寿命", "退化"]},
        {"name": "mtbfHours", "type": "decimal"},
        {"name": "connectionType", "type": "enum", "values": ["串联", "并联", "备用"]}
      ]
    },
    {
      "id": "support_node",
      "name": "保障节点",
      "description": "Airport or support point with stock, personnel, device capacity, and transfer policy.",
      "icon": "warehouse",
      "color": "#038387",
      "properties": [
        {"name": "nodeId", "type": "string", "isIdentifier": true},
        {"name": "nodeType", "type": "enum", "values": ["机场", "保障点", "库存点"]},
        {"name": "personnelCapacity", "type": "integer"},
        {"name": "equipmentCapacity", "type": "integer"},
        {"name": "policy", "type": "string"}
      ]
    },
    {
      "id": "support_activity",
      "name": "保障活动",
      "description": "Maintenance or support activity requiring personnel, devices, spares, and time.",
      "icon": "wrench",
      "color": "#FFB900",
      "properties": [
        {"name": "activityId", "type": "string", "isIdentifier": true},
        {"name": "activityType", "type": "enum", "values": ["飞行前保障", "修复性维修", "预防性维修", "再次出动准备"]},
        {"name": "durationHours", "type": "decimal"},
        {"name": "requiredPersonnel", "type": "integer"},
        {"name": "requiredDevices", "type": "integer"},
        {"name": "priority", "type": "integer"}
      ]
    }
  ],
  "bindings": [
    {
      "id": "binding_mission_profile",
      "boundEntityId": "mission_profile",
      "source": "project-json",
      "table": "missionProfiles",
      "columnMapping": {
        "profileId": "id",
        "profileType": "profileType",
        "repeatCycleHours": "repeatCycleHours",
        "endCondition": "endCondition"
      }
    },
    {
      "id": "binding_basic_mission",
      "boundEntityId": "basic_mission",
      "source": "project-json",
      "table": "missionProfiles.tasks",
      "columnMapping": {
        "missionId": "id",
        "successPoint": "successPoint",
        "startHour": "startHour",
        "priority": "priority",
        "minRequiredSorties": "minRequiredSorties"
      }
    },
    {
      "id": "binding_equipment",
      "boundEntityId": "equipment",
      "source": "project-json",
      "table": "equipmentAssets",
      "columnMapping": {
        "equipmentId": "id",
        "model": "model",
        "state": "state",
        "failureRate": "failureRate"
      }
    },
    {
      "id": "binding_component",
      "boundEntityId": "component",
      "source": "project-json",
      "table": "equipmentTree.components",
      "columnMapping": {
        "componentId": "id",
        "name": "name",
        "spareType": "spareType",
        "failureModel": "failureModel",
        "mtbfHours": "mtbfHours",
        "connectionType": "connectionType"
      }
    },
    {
      "id": "binding_support_node",
      "boundEntityId": "support_node",
      "source": "project-json",
      "table": "supportResources",
      "columnMapping": {
        "nodeId": "id",
        "nodeType": "nodeType",
        "personnelCapacity": "personnelCapacity",
        "equipmentCapacity": "equipmentCapacity",
        "policy": "policy"
      }
    },
    {
      "id": "binding_support_activity",
      "boundEntityId": "support_activity",
      "source": "project-json",
      "table": "supportActivities",
      "columnMapping": {
        "activityId": "id",
        "activityType": "activityType",
        "durationHours": "durationHours",
        "requiredPersonnel": "requiredPersonnel",
        "requiredDevices": "requiredDevices",
        "priority": "priority"
      }
    }
  ],
  "relationships": [
    {"id": "mission_belongs_to_profile", "name": "归属于", "from": "basic_mission", "to": "mission_profile", "cardinality": "many-to-one"},
    {"id": "phase_belongs_to_mission", "name": "归属于", "from": "mission_phase", "to": "basic_mission", "cardinality": "many-to-one"},
    {"id": "unit_deployed_at_node", "name": "部署在", "from": "combat_unit", "to": "support_node", "cardinality": "many-to-one"},
    {"id": "equipment_belongs_to_unit", "name": "隶属于", "from": "equipment", "to": "combat_unit", "cardinality": "many-to-one"},
    {"id": "equipment_assigned_to_mission", "name": "临时包含在", "from": "equipment", "to": "basic_mission", "cardinality": "many-to-many"},
    {"id": "phase_notifies_equipment_exit", "name": "通知退出编队", "from": "mission_phase", "to": "equipment", "cardinality": "many-to-many"},
    {"id": "component_installed_on_equipment", "name": "安装在", "from": "component", "to": "equipment", "cardinality": "many-to-one"},
    {"id": "equipment_creates_support_activity", "name": "创建", "from": "equipment", "to": "support_activity", "cardinality": "one-to-many"},
    {"id": "activity_staged_at_node", "name": "临时存放在", "from": "support_activity", "to": "support_node", "cardinality": "many-to-one"},
    {"id": "node_dispatches_activity", "name": "通知执行", "from": "support_node", "to": "support_activity", "cardinality": "one-to-many"},
    {"id": "activity_repairs_component", "name": "完成基础机维修", "from": "support_activity", "to": "component", "cardinality": "many-to-one"},
    {"id": "activity_updates_inventory", "name": "更新库存、查询延误时间", "from": "support_activity", "to": "support_node", "cardinality": "many-to-one"},
    {"id": "activity_changes_equipment_state", "name": "改变任务状态", "from": "support_activity", "to": "equipment", "cardinality": "many-to-one"}
  ]
}
