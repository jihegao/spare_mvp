{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/aircraft_support_v1_input.schema.json",
  "title": "Spare MVP Aircraft Support V1 Scenario Inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_identity",
    "mission_profile",
    "aircraft",
    "equipment_tree",
    "support_network",
    "support_activities",
    "time",
    "monte_carlo",
    "seed",
    "stop_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "aircraft-support-v1-input-v0" },
    "project_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "project_version", "scenario_id"],
      "properties": {
        "project_id": { "type": "string" },
        "project_version": { "type": "string" },
        "scenario_id": { "type": "string" },
        "source_import_id": { "type": ["string", "null"] }
      }
    },
    "mission_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "name",
        "duration_minutes",
        "basic_missions",
        "composite_tasks",
        "periodic_tasks",
        "mission_phases",
        "airports"
      ],
      "properties": {
        "profile_id": { "type": "string" },
        "name": { "type": "string" },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "basic_missions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "composite_tasks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "periodic_tasks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "mission_phases": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "airports": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "aircraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fleet_count", "initial_ready", "models"],
      "properties": {
        "fleet_count": { "type": "integer", "minimum": 1 },
        "initial_ready": { "type": "integer", "minimum": 0 },
        "models": { "type": "array", "items": { "type": "string" } },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tail_number", "aircraft_type", "model", "initial_state"],
            "properties": {
              "tail_number": { "type": "string" },
              "aircraft_type": { "type": "string" },
              "model": { "type": "string" },
              "initial_state": { "type": "string", "enum": ["available", "maintenance", "flying"] },
              "airport": { "type": "string" },
              "airport_id": { "type": "string" }
            }
          }
        }
      }
    },
    "equipment_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "root_component_id": { "type": ["string", "null"] },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "name", "quantity", "failure_rate"]
          }
        }
      }
    },
    "support_network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "name", "personnel_capacity", "equipment_capacity", "inventory", "transport_policies"]
          }
        }
      }
    },
    "support_activities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activities"],
      "properties": {
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "name", "activity_type", "equipment_id", "resource_id", "jobs"]
          }
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_minutes", "tick_minutes", "sample_every_minutes", "max_state_frames_single", "requested_steps"],
      "properties": {
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "tick_minutes": { "type": "integer", "const": 1 },
        "sample_every_minutes": { "type": "integer", "minimum": 1 },
        "max_state_frames_single": { "type": "integer", "minimum": 1 },
        "requested_steps": { "type": "integer", "minimum": 1 }
      }
    },
    "monte_carlo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "sweep"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "sweep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failureRates", "spareMultipliers", "supportCapacities"],
          "properties": {
            "failureRates": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "spareMultipliers": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "supportCapacities": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    "seed": { "type": "integer" },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "conditions"],
      "properties": {
        "schema_version": { "type": "string", "const": "stop-policy-v0" },
        "mode": { "type": "string", "enum": ["or", "and"] },
        "defaulted": { "type": "boolean" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["duration", "failure", "specified_time"] },
              "duration_minutes": { "type": "integer", "minimum": 1 },
              "minute": { "type": "integer", "minimum": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "duration" } }, "required": ["type"] },
                "then": { "required": ["duration_minutes"] }
              },
              {
                "if": { "properties": { "type": { "const": "specified_time" } }, "required": ["type"] },
                "then": { "required": ["minute"] }
              }
            ]
          }
        }
      }
    }
  }
}
