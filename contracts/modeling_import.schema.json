{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/modeling_import.schema.json",
  "title": "M5 Modeling Import Package",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "importId", "projectId", "lifecycle", "objects"],
  "allOf": [
    {
      "if": {
        "required": ["usedTables"],
        "properties": {
          "usedTables": {
            "required": ["supportResources"],
            "properties": {
              "supportResources": { "const": false }
            }
          }
        }
      },
      "else": {
        "properties": {
          "objects": {
            "required": ["supportResources"],
            "properties": {
              "supportResources": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["usedTables"],
        "properties": {
          "usedTables": {
            "required": ["supportActivities"],
            "properties": {
              "supportActivities": { "const": false }
            }
          }
        }
      },
      "else": {
        "properties": {
          "objects": {
            "required": ["supportActivities"],
            "properties": {
              "supportActivities": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["usedTables"],
        "properties": {
          "usedTables": {
            "required": ["reliabilityBlockDiagram"],
            "properties": {
              "reliabilityBlockDiagram": { "const": false }
            }
          }
        }
      },
      "else": {
        "properties": {
          "objects": {
            "required": ["reliabilityBlockDiagram"],
            "properties": {
              "reliabilityBlockDiagram": { "type": "object", "minProperties": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["usedTables"],
        "properties": {
          "usedTables": {
            "required": ["supportOrganization"],
            "properties": {
              "supportOrganization": { "const": false }
            }
          }
        }
      },
      "else": {
        "properties": {
          "objects": {
            "required": ["supportOrganization"],
            "properties": {
              "supportOrganization": {
                "type": "object",
                "required": ["tree"],
                "properties": {
                  "tree": { "type": "array", "minItems": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["usedTables"],
        "properties": {
          "usedTables": {
            "required": ["transportPolicies"],
            "properties": {
              "transportPolicies": { "const": false }
            }
          }
        }
      },
      "else": {
        "properties": {
          "objects": {
            "properties": {
              "supportResources": {
                "type": "array",
                "items": {
                  "required": ["transportPolicies"],
                  "properties": {
                    "transportPolicies": { "type": "array", "minItems": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": "modeling-import-v1" },
    "importId": { "type": "string" },
    "projectId": { "type": "string" },
    "usedTables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missionProfiles": { "type": "boolean" },
        "equipmentAssets": { "type": "boolean" },
        "reliabilityBlockDiagram": { "type": "boolean" },
        "supportResources": { "type": "boolean" },
        "supportActivities": { "type": "boolean" },
        "supportOrganization": { "type": "boolean" },
        "transportPolicies": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": { "type": "string", "enum": ["json_fixture", "csv_stub", "current_project_backfill"] },
        "name": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "version", "referencedRunIds"],
      "properties": {
        "state": { "type": "string", "enum": ["draft", "published"] },
        "version": { "type": "integer", "minimum": 1 },
        "referencedRunIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "objects": {
      "type": "object",
      "required": ["missionProfiles", "equipmentAssets"],
      "properties": {
        "missionProfiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/missionProfile" }
        },
        "equipmentAssets": {
          "type": "array",
          "items": { "$ref": "#/$defs/equipmentAsset" }
        },
        "supportResources": {
          "type": "array",
          "items": { "$ref": "#/$defs/supportResource" }
        },
        "supportActivities": {
          "type": "array",
          "items": { "$ref": "#/$defs/supportActivity" }
        },
        "supportOrganization": {
          "type": "object",
          "properties": {
            "tree": { "type": "array" }
          }
        },
        "reliabilityBlockDiagram": {
          "type": "object"
        }
      }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "validation": {
      "type": "object",
      "required": ["status", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["valid", "invalid"] },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationIssue" }
        }
      }
    }
  },
  "$defs": {
    "missionProfile": {
      "type": "object",
      "required": ["id", "name", "durationHours", "basicMissions"],
      "not": { "required": ["basicMission"] },
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "durationHours": { "type": "number", "exclusiveMinimum": 0 },
        "basicMissions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "required": ["id"] }
        }
      }
    },
    "equipmentAsset": {
      "type": "object",
      "required": ["id", "name", "quantity"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "mtbfHours": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "supportResource": {
      "type": "object",
      "required": ["id", "name", "capacity"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "capacity": { "type": "number", "exclusiveMinimum": 0 },
        "transportPolicies": {
          "type": "array",
          "items": { "$ref": "#/$defs/transportPolicy" }
        }
      }
    },
    "supportActivity": {
      "type": "object",
      "required": ["id", "name", "equipmentId", "resourceId", "durationHours"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "equipmentId": { "type": "string" },
        "resourceId": { "type": "string" },
        "durationHours": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "change": {
      "type": "object",
      "required": ["operation", "objectType", "objectId", "fieldPath"],
      "properties": {
        "operation": { "type": "string", "enum": ["create", "update", "delete"] },
        "objectType": { "type": "string" },
        "objectId": { "type": "string" },
        "fieldPath": { "type": "string" }
      }
    },
    "validationIssue": {
      "type": "object",
      "required": ["code", "severity", "page", "object_id", "field_path", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "warning"] },
        "page": { "type": "string" },
        "object_id": { "type": "string" },
        "field_path": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "transportPolicy": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
