{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/project.schema.json",
  "title": "Spare MVP Project JSON",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "scenarioId",
    "activeModule",
    "airports",
    "missionProfile",
    "basicMissions",
    "missionPhases",
    "combatUnit",
    "components",
    "supportNodes",
    "supportActivities"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "project-v0", "description": "Optional application envelope version; current frontend defaultScenario does not emit this field." },
    "project_id": { "type": "string" },
    "project_version": { "type": "string" },
    "scenarioId": { "type": "string" },
    "activeModule": { "type": "string", "enum": ["sparePlanning", "missionReliability"] },
    "airports": { "type": "array", "items": { "type": "string" } },
    "missionProfile": { "type": "object" },
    "basicMissions": { "type": "array", "items": { "type": "object" } },
    "missionPhases": { "type": "array", "items": { "type": "object" } },
    "combatUnit": { "type": "object" },
    "equipment": { "type": "object" },
    "components": { "type": "array", "items": { "type": "object" } },
    "supportNodes": { "type": "array", "items": { "type": "object" } },
    "supportResources": { "type": "array", "items": { "type": "object" } },
    "transportPolicies": { "type": "array", "items": { "type": "object" } },
    "supportActivityJobs": { "type": "array", "items": { "type": "object" } },
    "supportActivities": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
