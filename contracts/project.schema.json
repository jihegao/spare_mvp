{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/project.schema.json",
  "title": "Spare MVP Project JSON",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "scenarioId",
    "activeModule",
    "airports",
    "missionProfile",
    "basicMissions",
    "combatUnit",
    "products",
    "components",
    "supportNodes",
    "supportActivities"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "project-v0", "description": "Optional application envelope version; current frontend defaultScenario does not emit this field." },
    "project_id": { "type": "string" },
    "project_version": { "type": "string" },
    "scenarioId": { "type": "string" },
    "activeModule": { "type": "string", "enum": ["sparePlanning", "missionReliability"] },
    "airports": { "type": "array", "items": { "type": "string" } },
    "missionProfile": { "type": "object" },
    "basicMissions": { "type": "array", "items": { "type": "object" } },
    "missionPhases": { "type": "array", "items": { "type": "object" } },
    "combatUnit": { "type": "object" },
    "equipment": { "type": "object" },
    "products": { "type": "array", "items": { "type": "object" } },
    "components": { "type": "array", "items": { "type": "object" } },
    "reliabilityBlockDiagram": { "type": "object" },
    "supportNodes": { "type": "array", "items": { "type": "object" } },
    "supportResources": { "type": "array", "items": { "type": "object" } },
    "transportPolicies": { "type": "array", "items": { "type": "object" } },
    "supportActivityJobs": { "type": "array", "items": { "type": "object" } },
    "supportActivities": { "type": "array", "items": { "$ref": "#/$defs/supportActivity" } },
    "supportOrganization": {
      "type": "object",
      "properties": {
        "runtimeMode": { "enum": ["legacy", "vertical", "vertical_lateral"] }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "$defs": {
    "supportActivity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "planType": {
          "type": "string",
          "enum": [
            "使用保障方案",
            "直接准备方案",
            "再次出动准备方案",
            "飞行后检查方案",
            "修复性维修方案",
            "预防性维修方案",
            "后勤保障方案"
          ]
        },
        "planGroupId": { "type": "string", "minLength": 1 },
        "activityCodes": { "type": "array", "items": { "type": "string" } },
        "predecessors": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["planType"],
            "properties": {
              "planType": {
                "enum": ["直接准备方案", "再次出动准备方案", "飞行后检查方案"]
              }
            }
          },
          "then": {
            "required": ["planGroupId", "activityCodes", "predecessors"]
          }
        }
      ]
    }
  }
}
