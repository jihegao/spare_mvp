{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/aircraft_support_v1_project.schema.json",
  "title": "Spare MVP Aircraft Support V1 Clean Project JSON",
  "description": "Strict white-list Project JSON boundary for aircraft_support_v1 Scenario compilation. Runtime, UI draft, RMS allocation process, and run/result artifacts belong outside this payload; modeling import validation scope is retained as input provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioId",
    "activeModule",
    "airports",
    "missionProfile",
    "basicMissions",
    "combatUnit",
    "components",
    "supportNodes",
    "supportActivities"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "project-v0" },
    "project_id": { "type": "string" },
    "project_version": { "type": "string" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "activeModule": { "type": "string", "enum": ["sparePlanning", "missionReliability"] },
    "projectInfo": { "$ref": "#/$defs/governanceObject" },
    "equipment": { "$ref": "#/$defs/governanceObject" },
    "airports": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/airport" }
        ]
      }
    },
    "missionProfile": { "$ref": "#/$defs/missionProfile" },
    "basicMissions": { "type": "array", "items": { "$ref": "#/$defs/basicMission" } },
    "combatUnit": { "$ref": "#/$defs/combatUnit" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "supportNodes": { "type": "array", "items": { "$ref": "#/$defs/supportNode" } },
    "supportResources": { "type": "array", "items": { "$ref": "#/$defs/supportResource" } },
    "transportPolicies": { "type": "array", "items": { "$ref": "#/$defs/transportPolicy" } },
    "supportActivityJobs": { "type": "array", "items": { "$ref": "#/$defs/supportActivityJob" } },
    "supportActivities": { "type": "array", "items": { "$ref": "#/$defs/supportActivity" } },
    "supportOrganization": { "$ref": "#/$defs/supportOrganization" },
    "modelingImportValidation": { "$ref": "#/$defs/modelingImportValidation" }
  },
  "$defs": {
    "dictionary": { "type": "object", "additionalProperties": true },
    "governanceObject": { "type": "object", "additionalProperties": true },
    "openModelObject": {
      "type": "object",
      "additionalProperties": true,
      "not": { "$ref": "#/$defs/pollutionKeys" }
    },
    "airport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "supportNodeId": { "type": "string" }
      }
    },
    "missionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "allOf": [
        {
          "if": {
            "required": ["periodicTasks"],
            "properties": {
              "periodicTasks": {
                "contains": {
                  "anyOf": [
                    { "required": ["repeatWeeks"] },
                    { "required": ["cycleDays"] }
                  ]
                }
              }
            }
          },
          "then": { "not": { "required": ["durationHours"] } }
        }
      ],
      "properties": {
        "id": { "type": "string" },
        "profileId": { "type": "string" },
        "sourceImportId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "durationHours": { "type": "number", "minimum": 0 },
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "combatUnit": { "$ref": "#/$defs/combatUnit" },
        "compositeTasks": { "type": "array", "items": { "$ref": "#/$defs/compositeTask" } },
        "periodicTasks": { "type": "array", "items": { "$ref": "#/$defs/periodicTask" } }
      }
    },
    "compositeTask": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "priority": { "type": "integer", "minimum": 1 },
        "taskItems": { "type": "array", "items": { "$ref": "#/$defs/compositeTaskItem" } }
      },
      "not": { "$ref": "#/$defs/pollutionKeys" }
    },
    "compositeTaskItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basicMissionId": { "type": "string" },
        "basicTaskName": { "type": "string" },
        "groupName": { "type": "string" },
        "firstWaveTime": { "type": "string" },
        "dailyRepeatCount": { "type": "integer", "minimum": 0 },
        "intervalHours": { "type": "number", "minimum": 0 },
        "equipmentType": { "type": "string" }
      }
    },
    "periodicTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "repeatWeeks": { "type": "number", "minimum": 0 },
        "cycleDays": { "type": "number", "minimum": 0 },
        "compositeTasks": { "type": "array", "items": { "$ref": "#/$defs/periodicCompositeTask" } },
        "compositeTaskIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "periodicCompositeTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compositeTaskId": { "type": "string" },
        "week": { "type": ["string", "integer"] },
        "weekIndex": { "type": ["string", "integer"] },
        "weekday": { "type": ["string", "integer"] },
        "dayOfWeek": { "type": ["string", "integer"] }
      }
    },
    "basicMission": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "missionId": { "type": "string" },
        "supportActivityName": { "type": "string" },
        "minRequiredSorties": { "type": "integer", "minimum": 0 },
        "taskDurationMinutes": { "type": "integer", "minimum": 1 },
        "equipmentType": { "type": "string" },
        "equipmentQuantity": { "type": "integer", "minimum": 0 },
        "requiredEquipmentQuantity": { "type": "integer", "minimum": 0 },
        "missionPhases": { "type": "array", "items": { "$ref": "#/$defs/openModelObject" } }
      },
      "allOf": [
        { "not": { "$ref": "#/$defs/pollutionKeys" } },
        { "not": { "required": ["priority"] } }
      ]
    },
    "combatUnit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 0 },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "aircraftNo": { "type": "string" },
              "tailNumber": { "type": "string" },
              "tail_number": { "type": "string" },
              "model": { "type": "string" },
              "status": { "type": "string" },
              "airport": { "type": "string" },
              "airportId": { "type": "string" },
              "baseAirportId": { "type": "string" }
            }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "quantity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "aircraftModel": { "type": "string" },
        "productType": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 0 },
        "failureDistribution": { "$ref": "#/$defs/dictionary" },
        "repairDistribution": { "$ref": "#/$defs/dictionary" },
        "kOutOfN": { "$ref": "#/$defs/dictionary" },
        "specialRepairProfile": { "$ref": "#/$defs/specialRepairProfile" }
      }
    },
    "specialRepairProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repairTimeMinutes": { "type": "integer", "minimum": 1 }
      }
    },
    "supportNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "supportNodeName": { "type": "string" },
        "airport": { "type": "string" },
        "airportId": { "type": "string" },
        "baseAirportId": { "type": "string" },
        "nodeType": { "type": "string" },
        "supportLevel": { "type": "string" },
        "capacity": { "type": "integer", "minimum": 0 },
        "personnelCapacity": { "type": "integer", "minimum": 0 },
        "equipmentCapacity": { "type": "integer", "minimum": 0 },
        "inventory": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "lateralSupportNodes": { "type": "array", "items": { "type": "string" } },
        "transportPolicies": { "type": "array", "items": { "$ref": "#/$defs/transportPolicy" } },
        "policy": { "type": "string" },
        "organizationStrategy": { "type": "string" }
      }
    },
    "supportResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "quantity"],
      "properties": {
        "id": { "type": "string" },
        "supportNodeName": { "type": "string" },
        "organizationNodeName": { "type": "string" },
        "type": { "type": "string", "enum": ["personnel", "equipment", "spare"] },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 0 },
        "capacity": { "type": "integer", "minimum": 0 },
        "spareName": { "type": "string" },
        "spareType": { "type": "string" }
      }
    },
    "transportPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "fromSupportNodeName": { "type": "string" },
        "from": { "type": "string" },
        "toSupportNodeName": { "type": "string" },
        "to": { "type": "string" },
        "spareName": { "type": "string" },
        "spareType": { "type": "string" },
        "spare_type": { "type": "string" },
        "direction": { "type": "string" },
        "triggerMode": { "type": "string" },
        "criticalInventory": { "type": "integer", "minimum": 0 },
        "transferCycleHours": { "type": "number", "minimum": 0 },
        "capacity": { "type": "integer", "minimum": 0 },
        "priority": { "type": "integer", "minimum": 0 },
        "transportMode": { "type": "string" },
        "transportTimeHours": { "type": "number", "minimum": 0 },
        "transport_time_hours": { "type": "number", "minimum": 0 }
      }
    },
    "supportActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "activityName": { "type": "string" },
        "activityType": { "type": "string" },
        "planType": {
          "type": "string",
          "enum": ["使用保障方案", "修复性维修方案", "预防性维修方案", "后勤保障方案"]
        },
        "aircraftModel": { "type": "string" },
        "equipmentId": { "type": "string" },
        "priority": { "type": "integer", "minimum": 0 },
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "durationHours": { "type": "number", "minimum": 0 },
        "maxWorkTimeRefMinutes": { "type": "integer", "minimum": 0 },
        "plannedDowntimeHours": { "type": "number", "minimum": 0 },
        "spareQuantity": { "type": "integer", "minimum": 0 },
        "calendarDayInterval": { "type": ["integer", "null"], "minimum": 0 },
        "runHourInterval": { "type": ["number", "null"], "minimum": 0 },
        "takeoffLandingInterval": { "type": ["integer", "null"], "minimum": 0 },
        "floatRatio": { "type": ["number", "null"] },
        "activityCodes": { "type": "array", "items": { "type": "string" } },
        "predecessors": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "supportActivityJob": {
      "type": "object",
      "additionalProperties": true,
      "required": ["activityCode"],
      "properties": {
        "activityCode": { "type": "string", "minLength": 1 },
        "workName": { "type": "string" },
        "applicableAircraft": { "type": "string" },
        "durationMinutes": { "type": "integer", "minimum": 0 },
        "durationProfile": { "$ref": "#/$defs/dictionary" },
        "personnel": { "type": "array", "items": { "$ref": "#/$defs/openModelObject" } },
        "equipment": { "type": "array", "items": { "$ref": "#/$defs/openModelObject" } },
        "spare": { "type": "array", "items": { "$ref": "#/$defs/openModelObject" } },
        "ammunition": { "type": "array", "items": { "$ref": "#/$defs/openModelObject" } },
        "facility": { "type": "string" }
      },
      "not": {
        "anyOf": [
          { "$ref": "#/$defs/pollutionKeys" },
          { "required": ["predecessors"] },
          { "required": ["maxRepairTimeMinutes"] },
          { "required": ["meanRepairTimeMinutes"] },
          { "required": ["mttrMinutes"] },
          { "required": ["mttr"] },
          { "required": ["repairDistribution"] },
          { "required": ["repairDistributionType"] },
          { "required": ["repairTypes"] }
        ]
      }
    },
    "supportOrganization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tree": {
          "oneOf": [
            { "$ref": "#/$defs/supportOrganizationNode" },
            { "type": "array", "items": { "$ref": "#/$defs/supportOrganizationNode" } }
          ]
        }
      }
    },
    "supportOrganizationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/supportOrganizationNode" } }
      }
    },
    "modelingImportValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "importId": { "type": "string" },
        "usedTables": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "disabledDomains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/dictionary" }
        }
      }
    },
    "pollutionKeys": {
      "anyOf": [
        { "required": ["uiState"] },
        { "required": ["pageState"] },
        { "required": ["formState"] },
        { "required": ["selectedNodeId"] },
        { "required": ["expandedKeys"] },
        { "required": ["treeLayout"] },
        { "required": ["canvasLayout"] },
        { "required": ["draftState"] },
        { "required": ["missionAreas"] },
        { "required": ["mission_areas"] },
        { "required": ["monteCarlo"] },
        { "required": ["analysisRequests"] },
        { "required": ["experiment"] },
        { "required": ["seedPolicy"] },
        { "required": ["scenarioComposition"] },
        { "required": ["stopPolicy"] },
        { "required": ["validationReports"] },
        { "required": ["verificationResult"] },
        { "required": ["rmsAllocationPlan"] },
        { "required": ["rmsAllocationResult"] },
        { "required": ["allocationResults"] },
        { "required": ["missionExposure"] },
        { "required": ["exposureMatrix"] },
        { "required": ["rmsNodeResult"] },
        { "required": ["simulationRun"] },
        { "required": ["resultSummary"] },
        { "required": ["runResults"] },
        { "required": ["runtimeOutputs"] },
        { "required": ["artifactManifest"] },
        { "required": ["resultArtifacts"] },
        { "required": ["artifactPayload"] }
      ]
    }
  }
}
