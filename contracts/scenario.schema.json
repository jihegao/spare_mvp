{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/scenario.schema.json",
  "title": "Spare MVP Compiled Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "project_id",
    "scenario_version",
    "simulation_model",
    "compiled_from",
    "simulation_inputs"
  ],
  "oneOf": [
    {
      "type": "object",
      "required": ["simulation_model", "simulation_inputs"],
      "properties": {
        "simulation_model": { "$ref": "#/$defs/SmokeModelSelector" },
        "simulation_inputs": { "$ref": "#/$defs/SmokeInputs" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["simulation_model", "simulation_inputs"],
      "properties": {
        "simulation_model": { "$ref": "#/$defs/AviationSupportModelSelector" },
        "simulation_inputs": { "$ref": "#/$defs/AviationSupportInputs" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["simulation_model", "simulation_inputs"],
      "allOf": [
        {
          "properties": {
            "simulation_model": { "$ref": "#/$defs/AircraftSupportV1ModelSelector" }
          }
        },
        {
          "if": {
            "properties": {
              "simulation_model": {
                "type": "object",
                "properties": {
                  "family": { "const": "aircraft_support_v1" }
                },
                "required": ["family"]
              }
            },
            "required": ["simulation_model"]
          },
          "then": {
            "properties": {
              "simulation_inputs": {
                "$ref": "https://spare-mvp.local/contracts/aircraft_support_v1_input.schema.json"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "scenario-v0" },
    "scenario_id": { "type": "string" },
    "project_id": { "type": "string" },
    "scenario_version": { "type": "string" },
    "simulation_model": {
      "type": "object",
      "required": ["family", "model_id", "contract_version"],
      "properties": {
        "family": { "type": "string", "enum": ["smoke", "aviation_support", "aircraft_support_v1"] },
        "model_id": { "type": "string", "enum": ["SmokeSpareMvpModel", "AviationSupportModel", "AircraftSupportV1Model"] },
        "contract_version": { "type": "string", "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "compiled_at": { "type": "string" },
    "compiled_by": { "type": "string", "const": "Simulation Adapter Agent" },
    "compiled_from": {
      "type": "object",
      "required": ["project_id", "project_version", "project_schema_version"],
      "properties": {
        "project_id": { "type": "string" },
        "project_version": { "type": "string" },
        "project_schema_version": { "type": "string" },
        "mesa_contract_version": { "type": "string" },
        "mapping_provenance": {
          "type": "object",
          "required": [
            "project_id",
            "model_family",
            "mapping_version",
            "consumed_fields",
            "defaults_applied",
            "derived_fields",
            "ignored_fields",
            "unsupported_fields"
          ],
          "properties": {
            "project_id": { "type": "string" },
            "modeling_snapshot_id": { "type": ["string", "null"] },
            "experiment_plan_id": { "type": ["string", "null"] },
            "model_family": { "type": "string" },
            "mapping_version": { "type": "string" },
            "consumed_fields": { "type": "array", "items": { "type": "string" } },
            "defaults_applied": { "type": "array", "items": { "type": "string" } },
            "derived_fields": { "type": "array", "items": { "type": "string" } },
            "ignored_fields": { "type": "array", "items": { "type": "string" } },
            "governance_only_fields": { "type": "array", "items": { "type": "string" } },
            "unsupported_fields": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "simulation_inputs": { "type": "object" }
  },
  "$defs": {
    "SmokeModelSelector": {
      "type": "object",
      "required": ["family", "model_id", "contract_version"],
      "properties": {
        "family": { "const": "smoke" },
        "model_id": { "const": "SmokeSpareMvpModel" },
        "contract_version": { "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "AviationSupportModelSelector": {
      "type": "object",
      "required": ["family", "model_id", "contract_version"],
      "properties": {
        "family": { "const": "aviation_support" },
        "model_id": { "const": "AviationSupportModel" },
        "contract_version": { "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "AircraftSupportV1ModelSelector": {
      "type": "object",
      "required": ["family", "model_id", "contract_version"],
      "properties": {
        "family": { "const": "aircraft_support_v1" },
        "model_id": { "const": "AircraftSupportV1Model" },
        "contract_version": { "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "SmokeInputs": {
      "type": "object",
      "required": [
        "project_snapshot",
        "project_version",
        "active_module",
        "spare_multiplier",
        "failure_rate",
        "support_capacity",
        "min_required_sorties",
        "seed"
      ],
      "properties": {
        "project_snapshot": { "type": "object" },
        "project_version": { "type": "string" },
        "active_module": { "type": "string", "enum": ["sparePlanning", "missionReliability"] },
        "spare_multiplier": { "type": "number", "minimum": 0 },
        "failure_rate": { "type": "number", "minimum": 0 },
        "support_capacity": { "type": "integer", "minimum": 1 },
        "min_required_sorties": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "AviationSupportInputs": {
      "type": "object",
      "required": [
        "aircraft_count",
        "mission_count",
        "mission_aircraft_required",
        "mechanic_teams",
        "fuel_trucks",
        "maintenance_bays",
        "lru_failure_multiplier",
        "seed"
      ],
      "properties": {
        "aircraft_count": { "type": "integer", "minimum": 1 },
        "mission_count": { "type": "integer", "minimum": 1 },
        "mission_aircraft_required": { "type": "integer", "minimum": 1 },
        "mechanic_teams": { "type": "integer", "minimum": 1 },
        "fuel_trucks": { "type": "integer", "minimum": 1 },
        "maintenance_bays": { "type": "integer", "minimum": 1 },
        "lru_failure_multiplier": { "type": "number", "minimum": 0 },
        "seed": { "type": "integer" }
      },
      "additionalProperties": false
    }
  }
}
