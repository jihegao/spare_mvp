{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/scenario.schema.json",
  "title": "Spare MVP Compiled Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "project_id",
    "scenario_version",
    "simulation_model",
    "compiled_from",
    "simulation_inputs"
  ],
  "oneOf": [
    {
      "type": "object",
      "required": ["simulation_model", "simulation_inputs"],
      "allOf": [
        {
          "properties": {
            "simulation_model": { "$ref": "#/$defs/AircraftSupportV1ModelSelector" }
          }
        },
        {
          "if": {
            "properties": {
              "simulation_model": {
                "type": "object",
                "properties": {
                  "family": { "const": "aircraft_support_v1" }
                },
                "required": ["family"]
              }
            },
            "required": ["simulation_model"]
          },
          "then": {
            "properties": {
              "simulation_inputs": {
                "$ref": "https://spare-mvp.local/contracts/aircraft_support_v1_input.schema.json"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "scenario-v0" },
    "scenario_id": { "type": "string" },
    "project_id": { "type": "string" },
    "scenario_version": { "type": "string" },
    "simulation_model": {
      "type": "object",
      "required": ["family", "model_id", "contract_version"],
      "properties": {
        "family": {
          "description": "Current formal /api/runs model family.",
          "type": "string",
          "const": "aircraft_support_v1"
        },
        "model_id": {
          "description": "Current formal runtime model.",
          "type": "string",
          "const": "AircraftSupportV1Model"
        },
        "contract_version": { "type": "string", "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "compiled_at": { "type": "string" },
    "compiled_by": { "type": "string", "const": "Simulation Adapter Agent" },
    "compiled_from": {
      "type": "object",
      "required": ["project_id", "project_version", "project_schema_version"],
      "properties": {
        "project_id": { "type": "string" },
        "project_version": { "type": "string" },
        "project_schema_version": { "type": "string" },
        "mesa_contract_version": { "type": "string" },
        "mapping_provenance": {
          "type": "object",
          "required": [
            "project_id",
            "model_family",
            "mapping_version",
            "consumed_fields",
            "defaults_applied",
            "derived_fields",
            "ignored_fields",
            "unsupported_fields"
          ],
          "properties": {
            "project_id": { "type": "string" },
            "modeling_snapshot_id": { "type": ["string", "null"] },
            "experiment_plan_id": { "type": ["string", "null"] },
            "model_family": { "type": "string" },
            "mapping_version": { "type": "string" },
            "consumed_fields": { "type": "array", "items": { "type": "string" } },
            "defaults_applied": { "type": "array", "items": { "type": "string" } },
            "derived_fields": { "type": "array", "items": { "type": "string" } },
            "ignored_fields": { "type": "array", "items": { "type": "string" } },
            "governance_only_fields": { "type": "array", "items": { "type": "string" } },
            "runtime_deferred_fields": { "type": "array", "items": { "type": "string" } },
            "unsupported_fields": { "type": "array", "items": { "type": "string" } },
            "used_tables": {
              "type": "object",
              "additionalProperties": { "type": "boolean" }
            },
            "disabled_domains": { "type": "array", "items": { "type": "string" } },
            "validation_warnings": {
              "type": "array",
              "items": { "type": "object" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "simulation_inputs": { "type": "object" }
  },
  "$defs": {
    "AircraftSupportV1ModelSelector": {
      "description": "Current formal runtime selector for /api/runs.",
      "type": "object",
      "required": ["family", "model_id", "contract_version"],
      "properties": {
        "family": { "const": "aircraft_support_v1" },
        "model_id": { "const": "AircraftSupportV1Model" },
        "contract_version": { "const": "1.0.0" }
      },
      "additionalProperties": false
    }
  }
}
