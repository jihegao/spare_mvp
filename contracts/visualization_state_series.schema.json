{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/visualization_state_series.schema.json",
  "title": "Spare MVP Visualization State Series",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "scenario_version",
    "model_family",
    "artifact_manifest_id",
    "result_summary_id",
    "run_config_artifact_id",
    "input_project_artifact_id",
    "compiled_scenario_artifact_id",
    "frames"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "visualization-state-series-v0" },
    "organization_observability_version": { "const": "organization-observability-v1" },
    "run_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "scenario_version": { "type": "string" },
    "model_family": { "type": "string" },
    "artifact_manifest_id": { "type": "string" },
    "result_summary_id": { "type": "string" },
    "run_config_artifact_id": { "type": "string" },
    "input_project_artifact_id": { "type": "string" },
    "compiled_scenario_artifact_id": { "type": "string" },
    "organization_graph_identity": { "$ref": "#/$defs/organization_graph_identity" },
    "organization_dispatch_summary": { "$ref": "#/$defs/organization_dispatch_summary" },
    "mission_templates": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "failure_tree_templates": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_family": { "const": "aircraft_support_v1" }
        },
        "required": ["model_family"]
      },
      "then": {
        "properties": {
          "frames": {
            "items": {
              "properties": {
                "missions": {
                  "items": {
                    "oneOf": [
                      { "$ref": "#/$defs/aircraft_support_v1_mission" },
                      { "$ref": "#/$defs/aircraft_support_v1_compact_mission" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "organization_observability_version": { "const": "organization-observability-v1" } },
        "required": ["organization_observability_version"]
      },
      "then": {
        "required": ["organization_graph_identity", "organization_dispatch_summary"],
        "properties": {
          "frames": {
            "items": {
              "required": ["organization_graph_identity", "organization_dispatch_summary"],
              "properties": {
                "events": {
                  "items": {
                    "allOf": [{
                      "if": { "properties": { "event": { "pattern": "^organization_" } }, "required": ["event"] },
                      "then": {
                        "required": ["source_event_id", "event_sequence", "details"],
                        "properties": { "details": { "$ref": "#/$defs/organization_event_details" } }
                      }
                    }]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "step",
        "simulation_time",
        "trace",
        "aircraft_state",
        "mission_state",
        "resource_state",
        "event_summary",
        "aircraft",
        "missions",
        "resources",
        "spares",
        "jobs",
        "events"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "scenario_version": { "type": "string" },
        "artifact_manifest_id": { "type": "string" },
        "result_summary_id": { "type": "string" },
        "step": { "type": "integer", "minimum": 0 },
        "simulation_time": { "type": "number", "minimum": 0 },
        "sample_index": { "type": "integer", "minimum": 0 },
        "sample_step": { "type": "integer", "minimum": 0 },
        "seed": { "type": "integer" },
        "sweep": { "type": "object" },
        "trace": { "$ref": "#/$defs/frame_trace" },
        "aircraft_state": { "$ref": "#/$defs/aircraft_state" },
        "mission_state": { "$ref": "#/$defs/mission_state" },
        "resource_state": { "$ref": "#/$defs/resource_state" },
        "event_summary": { "$ref": "#/$defs/event_summary" },
        "organization_graph_identity": { "$ref": "#/$defs/organization_graph_identity" },
        "organization_dispatch_summary": { "$ref": "#/$defs/organization_dispatch_summary" },
        "aircraft": { "type": "array", "items": { "type": "object" } },
        "missions": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "array", "items": { "type": "object" } },
        "spares": { "type": "array", "items": { "type": "object" } },
        "jobs": { "type": "array", "items": { "type": "object" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
      }
    },
    "aircraft_support_v1_compact_mission": {
      "type": "object",
      "required": [
        "mission_id",
        "actual_start",
        "return_time",
        "status",
        "assigned_tail_numbers",
        "delay_minutes"
      ],
      "properties": {
        "mission_id": { "type": "string", "minLength": 1 },
        "actual_start": { "type": ["integer", "null"], "minimum": 0 },
        "return_time": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "type": "string", "minLength": 1 },
        "assigned_tail_numbers": { "type": "array", "items": { "type": "string" } },
        "delay_minutes": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "aircraft_support_v1_mission": {
      "type": "object",
      "required": [
        "mission_id",
        "name",
        "planned_start",
        "required_aircraft",
        "required_aircraft_type",
        "task_category",
        "basic_task_name",
        "wave_index",
        "day_index",
        "duration_minutes",
        "status",
        "assigned_tail_numbers"
      ],
      "properties": {
        "mission_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "planned_start": { "type": "integer", "minimum": 0 },
        "required_aircraft": { "type": "integer", "minimum": 1 },
        "required_aircraft_type": { "type": "string", "minLength": 1 },
        "task_category": { "type": "string", "minLength": 1 },
        "basic_task_name": { "type": "string", "minLength": 1 },
        "wave_index": { "type": "integer", "minimum": 1 },
        "day_index": { "type": "integer", "minimum": 1 },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1 },
        "assigned_tail_numbers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "frame_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "scenario_id",
        "scenario_version",
        "result_summary_id",
        "artifact_manifest_id",
        "run_config_artifact_id",
        "input_project_artifact_id",
        "compiled_scenario_artifact_id"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "scenario_version": { "type": "string" },
        "result_summary_id": { "type": "string" },
        "artifact_manifest_id": { "type": "string" },
        "run_config_artifact_id": { "type": "string" },
        "input_project_artifact_id": { "type": "string" },
        "compiled_scenario_artifact_id": { "type": "string" }
      }
    },
    "aircraft_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_rate",
        "operational_availability",
        "operational_availability_sample_count",
        "available_aircraft_hours",
        "total_aircraft_hours",
        "failed_count",
        "repairing_count",
        "sortie_count"
      ],
      "properties": {
        "ready_rate": { "type": "number" },
        "operational_availability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "operational_availability_sample_count": { "type": "integer", "minimum": 0 },
        "available_aircraft_hours": { "type": "integer", "minimum": 0 },
        "total_aircraft_hours": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "number" },
        "repairing_count": { "type": "number" },
        "sortie_count": { "type": "number" },
        "postflight_count": { "type": "number" },
        "preventive_count": { "type": "number" }
      }
    },
    "mission_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_success_rate", "sortie_rate", "mean_launch_time", "mean_recovery_time", "mean_turnaround_time"],
      "properties": {
        "mission_success_rate": { "type": "number" },
        "sortie_rate": { "type": "number" },
        "mean_launch_time": { "type": "number" },
        "mean_recovery_time": { "type": "number" },
        "mean_turnaround_time": { "type": "number" }
      }
    },
    "resource_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spare_fill_rate", "spare_utilization", "repair_backlog"],
      "properties": {
        "spare_fill_rate": { "type": "number" },
        "spare_utilization": { "type": "number" },
        "repair_backlog": { "type": "number" },
        "postflight_backlog": { "type": "number" },
        "preventive_backlog": { "type": "number" }
      }
    },
    "event_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortage_events",
        "downtime_failure_events",
        "downtime_spare_shortage_events",
        "downtime_resource_delay_events"
      ],
      "properties": {
        "shortage_events": { "type": "number" },
        "downtime_failure_events": { "type": "number" },
        "downtime_spare_shortage_events": { "type": "number" },
        "downtime_resource_delay_events": { "type": "number" },
        "downtime_equipment_shortage_events": { "type": "number" },
        "downtime_failure_hours": { "type": "number" },
        "downtime_equipment_shortage_hours": { "type": "number" },
        "downtime_spare_shortage_hours": { "type": "number" },
        "downtime_preventive_hours": { "type": "number" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "run_id", "step", "time", "event", "event_type", "message", "metric_refs"],
      "properties": {
        "event_id": { "type": "string" },
        "run_id": { "type": "string" },
        "step": { "type": "integer", "minimum": 0 },
        "time": { "type": "number", "minimum": 0 },
        "event": { "type": "string" },
        "event_type": { "type": "string" },
        "message": { "type": "string" },
        "metric_refs": { "type": "array", "items": { "type": "string" } },
        "source_event_id": { "type": "string", "minLength": 1 },
        "event_sequence": { "type": "integer", "minimum": 1 },
        "details": { "type": "object", "additionalProperties": true }
      }
    },
    "organization_graph_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_mode", "graph_hash", "hash_algorithm"],
      "properties": {
        "runtime_mode": { "enum": ["legacy", "vertical", "vertical_lateral"] },
        "graph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "hash_algorithm": { "const": "sha256" }
      }
    },
    "organization_dispatch_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "runtime_mode", "graph_hash", "hash_algorithm", "summary_scope", "sample_count",
        "observed_request_count", "observed_fulfilled_count", "observed_fulfillment_rate",
        "selection_counts_by_source_mode", "blocked_counts_by_reason", "candidate_rejection_counts_by_reason",
        "transport_batch_count", "transport_arrival_count", "observed_transport_wait_minutes", "interpretation"
      ],
      "properties": {
        "schema_version": { "const": "organization-dispatch-summary-v0" },
        "runtime_mode": { "enum": ["legacy", "vertical", "vertical_lateral"] },
        "graph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "hash_algorithm": { "const": "sha256" },
        "summary_scope": { "enum": ["single_run", "all_samples", "representative_sample"] },
        "sample_count": { "type": "integer", "minimum": 1 },
        "representative_sample_index": { "type": "integer", "minimum": 0 },
        "representative_seed": { "type": "integer" },
        "observed_request_count": { "type": "integer", "minimum": 0 },
        "observed_fulfilled_count": { "type": "integer", "minimum": 0 },
        "observed_fulfillment_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "selection_counts_by_source_mode": { "$ref": "#/$defs/non_negative_integer_map" },
        "blocked_counts_by_reason": { "$ref": "#/$defs/non_negative_integer_map" },
        "candidate_rejection_counts_by_reason": { "$ref": "#/$defs/non_negative_integer_map" },
        "transport_batch_count": { "type": "integer", "minimum": 0 },
        "transport_arrival_count": { "type": "integer", "minimum": 0 },
        "observed_transport_wait_minutes": { "type": "number", "minimum": 0 },
        "interpretation": { "const": "descriptive_observed_dispatch_facts_only_no_causal_attribution" }
      },
      "allOf": [{
        "if": { "properties": { "summary_scope": { "const": "representative_sample" } }, "required": ["summary_scope"] },
        "then": { "required": ["representative_sample_index", "representative_seed"] },
        "else": { "not": { "anyOf": [{ "required": ["representative_sample_index"] }, { "required": ["representative_seed"] }] } }
      }]
    },
    "non_negative_integer_map": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "organization_event_details": {
      "type": "object",
      "required": [
        "fact_type", "runtime_mode", "organization_graph_hash", "source_mode",
        "source_organization_node_id", "destination_organization_node_id", "destination_resource_id",
        "reason", "relation_id", "requested_minute", "wait_minutes", "requirement_type", "requirement_id"
      ],
      "properties": {
        "fact_type": {
          "enum": ["local_fulfilled", "selection_made", "candidate_rejected", "dispatch_started", "dispatch_arrived", "supply_blocked", "resource_released", "organization_fact"]
        },
        "runtime_mode": { "enum": ["legacy", "vertical", "vertical_lateral"] },
        "organization_graph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_mode": { "type": "string" },
        "source_organization_node_id": { "type": "string" },
        "destination_organization_node_id": { "type": "string" },
        "destination_resource_id": { "type": "string" },
        "reason": { "type": "string" },
        "relation_id": { "type": "string" },
        "requested_minute": { "type": "number", "minimum": 0 },
        "wait_minutes": { "type": "number", "minimum": 0 },
        "requirement_type": { "enum": ["spare", "personnel", "equipment", "organization"] },
        "requirement_id": { "type": "string", "minLength": 1 },
        "context": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
