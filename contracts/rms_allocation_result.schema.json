{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/rms_allocation_result.schema.json",
  "title": "RMS Allocation Result",
  "type": "object",
  "required": ["ok", "planId", "planVersion", "status", "algorithmVersion", "aircraftModel", "inputSnapshot", "method", "nodeResults", "totals", "warnings", "assumptions"],
  "additionalProperties": false,
  "properties": {
    "ok": { "type": "boolean" },
    "planId": { "type": "string", "minLength": 1 },
    "planVersion": { "type": "integer", "minimum": 1 },
    "planStatus": { "type": "string" },
    "status": { "type": "string" },
    "source": { "enum": ["calculated", "xlsx-import", "edited"] },
    "savedAt": { "type": "string" },
    "importedAt": { "type": "string" },
    "editedAt": { "type": "string" },
    "algorithmVersion": { "type": "string", "minLength": 1 },
    "aircraftModel": { "type": "string" },
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basicMissionId", "basicMissionName", "missionHours", "missionReliability", "mttrHours"],
      "properties": {
        "basicMissionId": { "type": "string" },
        "basicMissionName": { "type": "string" },
        "missionHours": { "type": "number", "minimum": 0 },
        "missionReliability": { "type": "number", "minimum": 0, "maximum": 1 },
        "mttrHours": { "type": "number", "minimum": 0 }
      }
    },
    "method": { "enum": ["equal", "proportional", "similar"] },
    "similarProduct": { "type": ["object", "null"] },
    "nodeResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "nodeName", "parentNodeId", "level", "model", "installationCount", "cumulativeInstallationCount", "runningRatio", "failureRate", "mtbfHours", "mttrHours", "localAllocationShare", "cumulativeAllocationShare", "riskBudget", "verificationStatus", "status"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "nodeName": { "type": "string", "minLength": 1 },
          "parentNodeId": { "type": "string", "minLength": 1 },
          "level": { "type": "string" },
          "model": { "type": "string" },
          "installationCount": { "type": "integer", "minimum": 1 },
          "cumulativeInstallationCount": { "type": "integer", "minimum": 1 },
          "runningRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "failureRate": { "type": "number", "minimum": 0 },
          "mtbfHours": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "mttrHours": { "type": ["number", "null"], "minimum": 0 },
          "localAllocationShare": { "type": "number", "minimum": 0, "maximum": 1 },
          "cumulativeAllocationShare": { "type": "number", "minimum": 0, "maximum": 1 },
          "riskBudget": { "type": "number", "minimum": 0 },
          "verificationStatus": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationCount", "allocationShare", "riskBudget", "missionReliability"],
      "properties": {
        "installationCount": { "type": "integer", "minimum": 0 },
        "allocationShare": { "type": "number", "minimum": 0, "maximum": 1.000000000001 },
        "riskBudget": { "type": "number", "minimum": 0 },
        "missionReliability": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "warnings": { "type": "array" },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  }
}
