{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/run.schema.json",
  "title": "Spare MVP Simulation Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "scenario_id",
    "scenario_version",
    "model_family",
    "model_id",
    "status",
    "artifact_manifest_id"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "run-v0" },
    "run_id": { "type": "string" },
    "project_id": { "type": "string" },
    "experiment_plan_id": { "type": "string" },
    "modeling_snapshot_id": { "type": ["string", "null"] },
    "project_version": { "type": ["string", "null"] },
    "project_schema_version": { "type": ["string", "null"] },
    "scenario_id": { "type": ["string", "null"] },
    "scenario_version": { "type": ["string", "null"] },
    "scenario_schema_version": { "type": ["string", "null"] },
    "model_family": {
      "description": "Current formal /api/runs model family.",
      "type": "string",
      "const": "aircraft_support_v1"
    },
    "model_id": {
      "description": "AircraftSupportV1Model is the current formal runtime model and ScenarioCompilerGate records compile-gate failures.",
      "type": "string",
      "enum": ["AircraftSupportV1Model", "ScenarioCompilerGate"]
    },
    "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"] },
    "phase": { "type": "string", "enum": ["queued", "running", "completed", "failed", "cancelled"] },
    "run_type": { "type": "string", "enum": ["single", "monte_carlo"] },
    "experiment_id": { "type": "string" },
    "experiment_type": { "type": "string", "enum": ["single", "monte_carlo"] },
    "mc_experiment_id": { "type": "string" },
    "seed": { "type": "integer" },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "queued_at": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "result_summary_id": { "type": ["string", "null"] },
    "artifact_manifest_id": { "type": "string" },
    "created_by": { "type": "string" },
    "lifecycle_status": { "type": "string", "enum": ["active", "archived", "deleted"] },
    "archived_at": { "type": ["string", "null"] },
    "archived_by": { "type": ["string", "null"] },
    "deleted_at": { "type": ["string", "null"] },
    "deleted_by": { "type": ["string", "null"] },
    "run_config": { "type": "object", "additionalProperties": true },
    "simulation_experiment_base": { "$ref": "#/$defs/SimulationExperimentBase" },
    "error": { "type": ["object", "null"] }
  },
  "$defs": {
    "SimulationExperimentBase": {
      "type": "object",
      "required": [
        "experiment_id",
        "experiment_type",
        "module",
        "project_id",
        "experiment_plan_id",
        "scenario_id",
        "scenario_version",
        "seed",
        "status",
        "progress",
        "run_id",
        "artifact_manifest_id",
        "artifact_ids"
      ],
      "properties": {
        "experiment_id": { "type": "string" },
        "experiment_type": { "type": "string", "enum": ["single", "monte_carlo"] },
        "module": { "type": "string" },
        "project_id": { "type": "string" },
        "experiment_plan_id": { "type": "string" },
        "modeling_snapshot_id": { "type": ["string", "null"] },
        "scenario_id": { "type": "string" },
        "scenario_version": { "type": "string" },
        "scenario_schema_version": { "type": "string" },
        "mapping_provenance": { "type": "object", "additionalProperties": true },
        "seed": { "type": "integer" },
        "status": { "type": "string" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "run_id": { "type": "string" },
        "artifact_manifest_id": { "type": "string" },
        "mc_experiment_id": { "type": "string" },
        "artifact_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
