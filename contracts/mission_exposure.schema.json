{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/mission_exposure.schema.json",
  "title": "Mission Exposure Matrix",
  "type": "object",
  "required": ["rows", "totalsByNode", "warnings"],
  "additionalProperties": true,
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "missionPhaseId", "state", "durationHours", "dutyCycle", "environmentFactor", "loadFactor", "equivalentHours"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "nodeName": { "type": "string" },
          "missionPhaseId": { "type": "string", "minLength": 1 },
          "missionPhaseName": { "type": "string" },
          "state": { "type": "string" },
          "durationHours": { "type": "number", "minimum": 0 },
          "dutyCycle": { "type": "number", "minimum": 0 },
          "environmentFactor": { "type": "number", "minimum": 0 },
          "loadFactor": { "type": "number", "minimum": 0 },
          "equivalentHours": { "type": "number", "minimum": 0 }
        }
      }
    },
    "totalsByNode": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["nodeId", "equivalentHours", "phaseCount"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "nodeName": { "type": "string" },
          "equivalentHours": { "type": "number", "minimum": 0 },
          "phaseCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": { "type": "array" }
  }
}
