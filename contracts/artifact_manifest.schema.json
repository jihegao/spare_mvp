{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/artifact_manifest.schema.json",
  "title": "Spare MVP Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_manifest_id",
    "run_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "artifact-manifest-v0" },
    "artifact_manifest_id": { "type": "string" },
    "run_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "scenario_version": { "type": "string" },
    "created_at": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "path", "media_type", "sha256"],
        "properties": {
          "artifact_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["input_project", "compiled_scenario", "snapshot", "time_series", "result_summary", "report", "log"]
          },
          "path": { "type": "string" },
          "media_type": { "type": "string" },
          "sha256": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "schema_version": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
