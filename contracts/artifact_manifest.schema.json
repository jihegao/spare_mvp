{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spare-mvp.local/contracts/artifact_manifest.schema.json",
  "title": "Spare MVP Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_manifest_id",
    "run_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "artifact-manifest-v0" },
    "artifact_manifest_id": { "type": "string" },
    "run_id": { "type": "string" },
    "scenario_id": { "type": ["string", "null"] },
    "scenario_version": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "path", "media_type", "sha256", "size_bytes"],
        "properties": {
          "artifact_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "input_project",
              "compiled_scenario",
              "run_config",
              "snapshot",
              "time_series",
              "visualization_state_series",
              "sample_results",
              "aggregate_result",
              "result_summary",
              "metrics",
              "report",
              "log",
              "monte_carlo_base",
              "analysis_projection_spare_shortfall",
              "analysis_projection_carry_list",
              "analysis_projection_mission_reliability",
              "analysis_projection_downtime_factors"
            ]
          },
          "analysis_type": {
            "type": "string",
            "enum": ["spare_shortfall", "carry_list", "mission_reliability", "downtime_factors"]
          },
          "source_artifact_id": { "type": "string" },
          "source_run_id": { "type": "string" },
          "source_result_summary_id": { "type": "string" },
          "source_scenario_id": { "type": "string" },
          "path": { "type": "string" },
          "media_type": { "type": "string" },
          "sha256": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "schema_version": { "type": "string" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "analysis_projection_spare_shortfall" } }, "required": ["kind"] },
            "then": {
              "required": ["analysis_type", "source_artifact_id"],
              "properties": { "analysis_type": { "const": "spare_shortfall" } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "analysis_projection_carry_list" } }, "required": ["kind"] },
            "then": {
              "required": ["analysis_type", "source_artifact_id"],
              "properties": { "analysis_type": { "const": "carry_list" } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "analysis_projection_mission_reliability" } }, "required": ["kind"] },
            "then": {
              "required": ["analysis_type", "source_artifact_id"],
              "properties": { "analysis_type": { "const": "mission_reliability" } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "analysis_projection_downtime_factors" } }, "required": ["kind"] },
            "then": {
              "required": ["analysis_type", "source_artifact_id"],
              "properties": { "analysis_type": { "const": "downtime_factors" } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "visualization_state_series" } }, "required": ["kind"] },
            "then": {
              "required": ["schema_version", "source_run_id", "source_result_summary_id", "source_scenario_id"],
              "properties": { "schema_version": { "const": "visualization-state-series-v0" } }
            }
          }
        ]
      }
    }
  }
}
