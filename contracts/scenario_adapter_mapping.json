{
  "schema_version": "scenario-adapter-mapping-v0",
  "role": "Evaluator-visible mapping from compiled Scenario JSON fields to Mesa model constructor inputs",
  "model_families": {
    "smoke": {
      "model_class": "SmokeSpareMvpModel",
      "simulation_inputs": {
        "project_snapshot": {
          "source": "Project JSON snapshot selected by Scenario compiler",
          "constructor_param": "projectData",
          "derived_by": "Simulation Adapter Agent"
        },
        "project_version": {
          "source": "Project JSON application envelope",
          "status": "metadata_only",
          "reason": "Project version is audit metadata for adapter bookkeeping; project_snapshot carries model input data."
        },
        "active_module": {
          "source": "project.activeModule",
          "constructor_param": "activeModule"
        },
        "spare_multiplier": {
          "source": "project.monteCarlo.spareMultipliers[]",
          "constructor_param": "spareMultiplier"
        },
        "failure_rate": {
          "source": "project.components[].failureRate",
          "constructor_param": "failureRate"
        },
        "support_capacity": {
          "source": "project.supportNodes[].equipmentCapacity",
          "constructor_param": "supportCapacity"
        },
        "min_required_sorties": {
          "source": "project.equipment.minRequiredSorties / project.basicMission.minRequiredSorties",
          "constructor_param": "minRequiredSorties"
        },
        "seed": {
          "source": "project.experiment.seed",
          "constructor_param": "seed"
        }
      }
    },
    "aviation_support": {
      "model_class": "AviationSupportModel",
      "simulation_inputs": {
        "aircraft_count": {
          "source": "project.equipment.quantity",
          "constructor_param": "aircraft_count"
        },
        "mission_count": {
          "source": "project.missionProfile.missionCount, defaulted to 3 when absent",
          "constructor_param": "mission_count"
        },
        "mission_aircraft_required": {
          "source": "project.basicMission.equipmentQuantity",
          "constructor_param": "mission_aircraft_required"
        },
        "mechanic_teams": {
          "source": "project.supportNodes[].personnelCapacity",
          "constructor_param": "mechanic_teams"
        },
        "fuel_trucks": {
          "source": "project.supportNodes[].equipmentCapacity",
          "constructor_param": "fuel_trucks",
          "derived_by": "Simulation Adapter Agent"
        },
        "maintenance_bays": {
          "source": "project.supportNodes[].equipmentCapacity",
          "constructor_param": "maintenance_bays",
          "derived_by": "Simulation Adapter Agent"
        },
        "lru_failure_multiplier": {
          "source": "project.monteCarlo.lruFailureMultipliers[], defaulted to 1.0 when absent",
          "constructor_param": "lru_failure_multiplier"
        },
        "seed": {
          "source": "project.experiment.seed",
          "constructor_param": "seed"
        }
      }
    },
    "aircraft_support_v1": {
      "model_class": "AircraftSupportV1Model",
      "simulation_inputs": {
        "schema_version": {
          "source": "aircraft_support_v1 input schema contract",
          "status": "metadata_only",
          "reason": "The schema version selects the governed input contract and is not a model constructor parameter."
        },
        "project_identity": {
          "source": "Project JSON identity envelope and Scenario compiler provenance",
          "status": "governance_only",
          "reason": "Identity fields trace the compiled platform chain and do not change simulation dynamics."
        },
        "mission_profile": {
          "source": "project.missionProfile, project.basicMission, project.missionPhases, project.airports, project.missionAreas",
          "constructor_param": "mission_profile"
        },
        "aircraft": {
          "source": "project.equipment.quantity, project.equipment.initialReady, project.equipment.wholeMachineModels",
          "constructor_param": "aircraft"
        },
        "equipment_tree": {
          "source": "project.components[] including failureDistribution, kOutOfN, lifeLimitHours, RMS, spareType, and specialRepairProfile",
          "constructor_param": "equipment_tree"
        },
        "support_network": {
          "source": "project.supportNodes[] including capacities, inventory, lateral support nodes, and transport policies",
          "constructor_param": "support_network"
        },
        "support_activities": {
          "source": "project.supportActivities[] including jobs, duration profiles, resources, spares, and predecessor DAG",
          "constructor_param": "support_activities"
        },
        "reliability_block_diagram": {
          "source": "project.reliabilityBlockDiagram",
          "constructor_param": "reliability_block_diagram"
        },
        "time": {
          "source": "project.missionProfile.durationHours and M9.7 default tick/sample policy",
          "constructor_param": "time_config"
        },
        "monte_carlo": {
          "source": "project.experiment.samples and project.monteCarlo sweep arrays",
          "constructor_param": "monte_carlo_config"
        },
        "seed": {
          "source": "project.experiment.seed",
          "constructor_param": "seed"
        }
      }
    }
  }
}
